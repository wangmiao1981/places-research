# .env.example
# Copy this file to .env and fill in your actual keys.
# DO NOT commit your .env file to version control!

# Google Maps Places API (required for data collection)
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"

# Tavily web search API (required for web research stage)
TAVILY_API_KEY="YOUR_TAVILY_API_KEY_HERE"

# LLM authentication — use ONE of the following:
# Option 1: Direct Anthropic API key
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY_HERE"

# Option 2: AWS Bedrock with bearer token (no boto3/SigV4 needed)
# AWS_BEARER_TOKEN_BEDROCK="YOUR_BEARER_TOKEN_HERE"
# AWS_REGION="us-west-2"

# Option 3: AWS Bedrock with IAM credentials (requires anthropic[bedrock])
# AWS_ACCESS_KEY_ID="YOUR_ACCESS_KEY_HERE"
# AWS_SECRET_ACCESS_KEY="YOUR_SECRET_KEY_HERE"
# AWS_REGION="us-west-2"
